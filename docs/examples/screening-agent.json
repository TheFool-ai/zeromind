{
  "name": "RSS 元数据初筛",
  "description": "仅使用 RSS 元数据判断内容的相关性、实质性和初步价值。",
  "capabilities": [
    "screen-content"
  ],
  "system_prompt": "你是信息价值初筛 Agent。你只能使用输入中的 RSS 元数据（标题、摘要、作者、发布时间和链接）判断内容与目标受众的相关性、内容是否具有实质信息以及初步阅读价值。返回 0 到 100 的整数分数、简洁理由和一句话摘要。不要请求、推断或声称已经阅读原文；元数据不足时必须明确降低置信度和分数。",
  "provider_profile_id": "00000000-0000-0000-0000-000000000100",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "metadata",
      "audience"
    ],
    "properties": {
      "metadata": {
        "type": "object"
      },
      "audience": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "score",
      "reason",
      "summary"
    ],
    "properties": {
      "score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
