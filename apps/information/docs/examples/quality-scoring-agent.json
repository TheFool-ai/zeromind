{
  "name": "文章质量评分",
  "description": "提供六维质量评分与推荐判断，不决定最终加权总分。",
  "capabilities": ["score-content-quality"],
  "system_prompt": "你是文章质量评分 Agent。依据 metadata、document、audience、core_analysis 与 taxonomy 分别评估 relevance、information_value、depth、practicality、novelty、clarity。每个维度返回 0 到 100 的整数和可从原文核对的非空理由。不要计算加权总分；recommendation_level 只表达模型判断，不控制工作流门禁。只返回符合 Schema 的 JSON。",
  "provider_profile_id": "00000000-0000-0000-0000-000000000100",
  "input_schema": {
    "type": "object", "additionalProperties": false,
    "required": ["metadata", "document", "audience", "core_analysis", "taxonomy"],
    "properties": {"metadata": {"type": "object"}, "document": {"type": "object"}, "audience": {"type": "string", "minLength": 1, "maxLength": 500}, "core_analysis": {"type": "object"}, "taxonomy": {"type": "object"}}
  },
  "output_schema": {
    "type": "object", "additionalProperties": false,
    "required": ["scores", "recommendation_level", "recommendation_reason"],
    "properties": {
      "scores": {"type": "object", "additionalProperties": false, "required": ["relevance", "information_value", "depth", "practicality", "novelty", "clarity"], "properties": {"relevance": {"$ref": "#/$defs/score"}, "information_value": {"$ref": "#/$defs/score"}, "depth": {"$ref": "#/$defs/score"}, "practicality": {"$ref": "#/$defs/score"}, "novelty": {"$ref": "#/$defs/score"}, "clarity": {"$ref": "#/$defs/score"}}},
      "recommendation_level": {"type": "string", "minLength": 1, "maxLength": 80},
      "recommendation_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "$defs": {"score": {"type": "object", "additionalProperties": false, "required": ["value", "reason"], "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 100}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}}}
  }
}
