# Copy to .env and replace every placeholder before production use.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ZEROMIND_ADMIN_USERNAME=admin
ZEROMIND_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ZEROMIND_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ZEROMIND_CREDENTIAL_SECRET=replace-with-another-32-random-bytes
ZEROMIND_PORT=8080

# Provider credentials are read at execution time. Their values are never stored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Example webhook secret referenced by a Webhook configuration.
ZEROMIND_WEBHOOK_SECRET=
